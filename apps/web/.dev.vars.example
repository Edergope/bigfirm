# Copia a `.dev.vars` (ignorado por git) y rellena. NUNCA versionar secretos reales.
#
# SEGURIDAD (fail-closed): `IUSIA_ENV` NO está en wrangler.jsonc (config deployable) NI
# en `.dev.vars`. Para el runtime LOCAL de Vite lo fija `vite.config.ts` (development en
# `pnpm dev` normal; staging en modo `IUSIA_RAG_E2E=1`). `vite.config.ts` no lo lee
# `wrangler deploy`, así que un deploy deja IUSIA_ENV=undefined → rutas dev bloqueadas (404).
# `APP_URL` local (baseURL de Better Auth); en staging/producción se suministra por entorno,
# nunca localhost ni en config deployable.
APP_URL="http://localhost:5173"

# Genera el secreto de sesión con:  openssl rand -base64 32
BETTER_AUTH_SECRET="cambia-esto-por-un-secreto-aleatorio-de-32-bytes"

# Cuenta de Cloudflare y token del AI Gateway (capa de modelos).
CLOUDFLARE_ACCOUNT_ID=""
AI_GATEWAY_TOKEN=""

# OAuth de Google (Drive Picker / Docs). Opcional hasta aprovisionar credenciales.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (NotificationService). Sin API key, las notificaciones quedan NOT_CONFIGURED.
RESEND_API_KEY=""
RESEND_FROM="IUSIA <notificaciones@iusia.legal>"
