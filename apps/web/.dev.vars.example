# Copia a `.dev.vars` (ignorado por git) y rellena. NUNCA versionar secretos reales.
#
# SEGURIDAD (fail-closed): `IUSIA_ENV` y `APP_URL` NO están en wrangler.jsonc (config
# deployable). El harness dev (/api/dev/*) sólo se habilita cuando IUSIA_ENV="development",
# lo que se activa EXCLUSIVAMENTE aquí para desarrollo local. Un `wrangler deploy` sin
# suministrar IUSIA_ENV lo deja undefined → rutas dev bloqueadas (404).
IUSIA_ENV="development"
# URL local de la app (baseURL de Better Auth). En staging/producción se suministra por
# entorno (wrangler deploy --var APP_URL=... o config por-entorno); nunca localhost.
APP_URL="http://localhost:5173"

# Genera el secreto de sesión con:  openssl rand -base64 32
BETTER_AUTH_SECRET="cambia-esto-por-un-secreto-aleatorio-de-32-bytes"

# Cuenta de Cloudflare y token del AI Gateway (capa de modelos).
CLOUDFLARE_ACCOUNT_ID=""
AI_GATEWAY_TOKEN=""

# OAuth de Google (Drive Picker / Docs). Opcional hasta aprovisionar credenciales.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (NotificationService). Sin API key, las notificaciones quedan NOT_CONFIGURED.
RESEND_API_KEY=""
RESEND_FROM="IUSIA <notificaciones@iusia.legal>"
