{
  "name": "@iusia/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types ./worker-configuration.d.ts",
    "migrate:local": "wrangler d1 migrations apply iusia-db --local",
    "migrate:remote": "wrangler d1 migrations apply iusia-db --remote",
    "auth:generate": "better-auth generate --config src/worker/auth/config.ts --output ../../packages/db/src/schema/auth.generated.ts",
    "prompts:sync:local": "node ../../scripts/sync-prompts.mjs --local",
    "prompts:sync:remote": "node ../../scripts/sync-prompts.mjs --remote"
  },
  "dependencies": {
    "@iusia/agents": "workspace:*",
    "@iusia/db": "workspace:*",
    "@iusia/domain": "workspace:*",
    "@iusia/orchestration": "workspace:*",
    "@iusia/ui": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "@xyflow/react": "^12.11.3",
    "agents": "^0.21.0",
    "better-auth": "^1.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.3",
    "lucide-react": "^0.552.0",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "wrangler": "^4.125.0"
  }
}
