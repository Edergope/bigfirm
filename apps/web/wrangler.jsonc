{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iusia",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true,
    // Traces técnicos, no auditoría jurídica. El audit ledger vive en D1.
    "logs": { "enabled": true, "invocation_logs": true }
  },

  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // El Worker atiende primero API y auth; el resto lo sirve el SPA.
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "iusia-db",
      // PENDIENTE: reemplazar por el id real tras `wrangler d1 create iusia-db`.
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      // Artefactos versionados de prompts. NUNCA documentos de cliente.
      "binding": "PROMPTS",
      "bucket_name": "iusia-prompts"
    },
    {
      // Salidas de agentes y espejos normalizados para indexación.
      "binding": "ARTIFACTS",
      "bucket_name": "iusia-artifacts"
    }
  ],

  "durable_objects": {
    // Un solo runtime genérico para los 30 agentes. Cada ejecución se direcciona
    // por execution_id, de modo que cada sub-agente tiene identidad y estado propios.
    "bindings": [{ "name": "LegalWorker", "class_name": "LegalWorker" }]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LegalWorker"]
    }
  ],

  "workflows": [
    {
      "name": "iusia-matter-orchestration",
      "binding": "MATTER_ORCHESTRATION",
      "class_name": "MatterOrchestrationWorkflow"
    }
  ],

  "queues": {
    "producers": [{ "binding": "DOCUMENT_INGESTION", "queue": "iusia-document-ingestion" }],
    "consumers": [
      {
        "queue": "iusia-document-ingestion",
        "max_batch_size": 10,
        "max_retries": 3,
        "dead_letter_queue": "iusia-document-ingestion-dlq"
      }
    ]
  },

  "analytics_engine_datasets": [{ "binding": "USAGE_ANALYTICS", "dataset": "iusia_usage" }],

  // SEGURIDAD (fail-closed): la config base/deployable NUNCA declara IUSIA_ENV ni APP_URL.
  //  - `IUSIA_ENV` sólo se activa en desarrollo LOCAL vía `.dev.vars` (IUSIA_ENV=development);
  //    un `wrangler deploy` sin selección explícita de entorno deja IUSIA_ENV=undefined, y el
  //    gate del harness (igualdad estricta a "development") bloquea las rutas dev (fail-closed).
  //  - `APP_URL` se suministra por entorno: en local vía `.dev.vars`; en staging/producción debe
  //    aportarse explícitamente (wrangler deploy --var APP_URL=... o config por-entorno). Ver
  //    docs/PENDIENTES.md → DEPLOY_APP_URL_CONFIGURATION_REQUIRED. No se hardcodea aquí.
  "vars": {
    // Ruta lógica del AI Gateway (idéntica en todos los entornos). Los secretos van por
    // `wrangler secret`/`.dev.vars`, nunca aquí.
    "AI_GATEWAY_NAME": "iusia"
  },

  // ENVIRONMENT STAGING (Bloque 3): recursos Cloudflare REALES en la cuenta
  // e4478495… (perfil wrangler `iusia`). Los environments de Wrangler NO heredan
  // bindings, así que se redeclaran todos. `migrations`, `main` y `compatibility_*`
  // sí se heredan del nivel base. IUSIA_ENV=staging cierra el harness dev (404).
  // APP_URL NO se declara aquí: se aporta al desplegar (Bloque 5). El desarrollo
  // local (`pnpm dev`, sin --env) sigue usando la config base (Miniflare).
  "env": {
    "staging": {
      "vars": {
        "AI_GATEWAY_NAME": "iusia",
        "IUSIA_ENV": "staging"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "iusia-db",
          "database_id": "ead5c7aa-fd00-4515-9964-dc0c09db3046",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "PROMPTS", "bucket_name": "iusia-prompts" },
        { "binding": "ARTIFACTS", "bucket_name": "iusia-artifacts" }
      ],
      "durable_objects": {
        "bindings": [{ "name": "LegalWorker", "class_name": "LegalWorker" }]
      },
      "workflows": [
        {
          "name": "iusia-matter-orchestration",
          "binding": "MATTER_ORCHESTRATION",
          "class_name": "MatterOrchestrationWorkflow"
        }
      ],
      "queues": {
        "producers": [{ "binding": "DOCUMENT_INGESTION", "queue": "iusia-document-ingestion" }],
        "consumers": [
          {
            "queue": "iusia-document-ingestion",
            "max_batch_size": 10,
            "max_retries": 3,
            "dead_letter_queue": "iusia-document-ingestion-dlq"
          }
        ]
      },
      "ai_search": [{ "binding": "AI_SEARCH", "instance_name": "iusia-rag-e2e" }],
      "analytics_engine_datasets": [{ "binding": "USAGE_ANALYTICS", "dataset": "iusia_usage" }]
    }
  }
}
