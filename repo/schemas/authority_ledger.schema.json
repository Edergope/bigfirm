{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuthorityLedger",
  "description": "Schema determinístico para el Ledger de Autoridades Normativas y Jurisprudenciales",
  "type": "object",
  "required": ["matter_id", "authorities"],
  "properties": {
    "matter_id": { "type": "string" },
    "authorities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["authority_id", "citation", "status", "rule_summary"],
        "properties": {
          "authority_id": { "type": "string", "pattern": "^AUTH-[0-9]{2,}$" },
          "citation": { "type": "string" },
          "type": { "type": "string", "enum": ["CONSTITUTION", "STATUTE", "DECREE", "RESOLUTION", "CIRCULAR", "JURISPRUDENCE", "DOCTRINE"] },
          "status": { "type": "string", "enum": ["VERIFIED_CURRENT", "SUPERSEDED", "REQUIRES_CALIBRATION"] },
          "rule_summary": { "type": "string" }
        }
      }
    }
  }
}
