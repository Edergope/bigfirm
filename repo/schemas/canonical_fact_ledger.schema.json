{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CanonicalFactLedger",
  "description": "Schema determinístico para el Ledger de Hechos Canónicos de Pisoso Legal AI v5.3",
  "type": "object",
  "required": ["matter_id", "date_established", "facts", "entities"],
  "properties": {
    "matter_id": {
      "type": "string",
      "pattern": "^CASE-[0-9]{4}-[A-Z0-9]+$"
    },
    "date_established": {
      "type": "string"
    },
    "governance_version": {
      "type": "string",
      "default": "v5.3.0"
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "role"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["PERSON", "COMPANY", "GOVERNMENT_ENTITY", "COURT", "OTHER"] },
          "role": { "type": "string" },
          "aliases": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fact_id", "statement", "certainty", "source_class"],
        "properties": {
          "fact_id": {
            "type": "string",
            "pattern": "^FACT-[0-9]{2,}$"
          },
          "statement": {
            "type": "string"
          },
          "certainty": {
            "type": "string",
            "enum": ["[F]", "[A]", "[D]", "[I]", "[C]", "[U]", "[R]", "[X]"]
          },
          "source_class": {
            "type": "string",
            "enum": ["Class A", "Class B", "Class C", "Class D", "Class E", "Class F"]
          },
          "primary_source": {
            "type": "string"
          },
          "numbers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["value", "unit"],
              "properties": {
                "raw_text": { "type": "string" },
                "value": { "type": "number" },
                "unit": { "type": "string", "enum": ["COP", "USD", "PERCENT", "DAYS", "MONTHS", "YEARS", "SQM", "UNITS", "OTHER"] }
              }
            }
          }
        }
      }
    }
  }
}
