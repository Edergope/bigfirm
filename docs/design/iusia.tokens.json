{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "IUSIA design tokens. Derivados de IUSIA_UI_UX_Design_System_MVP_v1.pdf. Fuente única de verdad visual; espejo de packages/ui/src/tokens.",
  "color": {
    "navy":    { "$value": "#0B1D3A", "$type": "color", "$description": "Marca, navegación, autoridad" },
    "carbon":  { "$value": "#1F2937", "$type": "color", "$description": "Texto principal" },
    "action":  { "$value": "#2563EB", "$type": "color", "$description": "CTA, foco, selección" },
    "intel":   { "$value": "#22C7E8", "$type": "color", "$description": "IA, nodos, flujos (decorativo/no-texto)" },
    "intelText":{ "$value": "#0F798F", "$type": "color", "$description": "intel a ≥4.5:1 AA sobre paper y tinte /15 — usar cuando intel es texto" },
    "gold":    { "$value": "#C9A24B", "$type": "color", "$description": "Acento premium mínimo (decorativo/no-texto)" },
    "goldText":{ "$value": "#8B6D2A", "$type": "color", "$description": "gold a ≥4.5:1 AA sobre paper y tinte /10 — usar cuando gold es texto" },
    "mist":    { "$value": "#A7ADB5", "$type": "color", "$description": "Bordes decorativos, dividers, tintes de fondo (no usar como texto)" },
    "mistText":{ "$value": "#68707B", "$type": "color", "$description": "Texto mudo (metadata/hints/labels) — mist a ≥4.5:1 AA sobre paper/surface/tinte" },
    "mistStrong":{ "$value": "#89919B", "$type": "color", "$description": "Borde de control interactivo — mist a ≥3:1 (WCAG 1.4.11)" },
    "surface": { "$value": "#F7F8FA", "$type": "color", "$description": "Superficies generales" },
    "paper":   { "$value": "#FFFFFF", "$type": "color", "$description": "Lectura y tarjetas" },
    "success": { "$value": "#16A34A", "$type": "color", "$description": "Decorativo/no-texto (dots, iconos, fondos)" },
    "successText":{ "$value": "#11803A", "$type": "color", "$description": "success a ≥4.5:1 AA sobre paper y tinte /10 — usar cuando success es texto" },
    "warning": { "$value": "#D97706", "$type": "color", "$description": "Decorativo/no-texto (dots, iconos, fondos)" },
    "warningText":{ "$value": "#A65B05", "$type": "color", "$description": "warning a ≥4.5:1 AA sobre paper y tinte /10 — usar cuando warning es texto" },
    "critical":{ "$value": "#DC2626", "$type": "color", "$description": "Ya ≥4.5:1 AA como texto" },
    "info":    { "$value": "#2563EB", "$type": "color", "$description": "Ya ≥4.5:1 AA como texto" }
  },
  "font": {
    "family": { "$value": "Inter, \"Geist Sans\", ui-sans-serif, system-ui, sans-serif", "$type": "fontFamily" },
    "size": {
      "meta":  { "$value": "13px", "$type": "dimension" },
      "body":  { "$value": "15px", "$type": "dimension" },
      "bodyLg":{ "$value": "16px", "$type": "dimension" },
      "h4":    { "$value": "17px", "$type": "dimension" },
      "h3":    { "$value": "20px", "$type": "dimension" },
      "h2":    { "$value": "24px", "$type": "dimension" },
      "h1":    { "$value": "30px", "$type": "dimension" }
    }
  },
  "space": {
    "1": { "$value": "8px", "$type": "dimension" },
    "2": { "$value": "12px", "$type": "dimension" },
    "3": { "$value": "16px", "$type": "dimension" },
    "4": { "$value": "24px", "$type": "dimension" },
    "5": { "$value": "32px", "$type": "dimension" },
    "6": { "$value": "48px", "$type": "dimension" }
  },
  "radius": {
    "sm":   { "$value": "8px", "$type": "dimension" },
    "md":   { "$value": "10px", "$type": "dimension" },
    "card": { "$value": "14px", "$type": "dimension" },
    "pill": { "$value": "9999px", "$type": "dimension" }
  },
  "shadow": {
    "hairline": { "$value": "0 1px 2px rgba(11,29,58,0.06)", "$type": "shadow" },
    "raised":   { "$value": "0 4px 16px -6px rgba(11,29,58,0.16)", "$type": "shadow" },
    "overlay":  { "$value": "0 24px 60px -20px rgba(11,29,58,0.35)", "$type": "shadow" }
  },
  "layout": {
    "sidebarWidth":  { "$value": "236px", "$type": "dimension" },
    "topbarHeight":  { "$value": "64px", "$type": "dimension" }
  }
}
